# کپی کن به .env.local و مقدارها را پر کن. این فایل هرگز مقدار واقعی نداشته باشد.

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# فاز ۲ — دیتابیس (مقدار پیش‌فرض با docker/compose.dev.yml هماهنگ است)
DATABASE_URL="postgresql://bank_abzar:bank_abzar_dev@localhost:5432/bank_abzar"

# فاز ۳ — احراز هویت و پیامک (SESSION_SECRET حداقل ۳۲ کاراکتر)
SESSION_SECRET="dev-only-change-this-to-a-random-secret-at-least-32-characters"
SMS_PROVIDER=
SMS_API_KEY=

# فاز ۴ — کرون انقضای سفارش (حداقل ۱۶ کاراکتر)
CRON_SECRET=

# فاز ۵ — پرداخت
ZARINPAL_MERCHANT_ID=
