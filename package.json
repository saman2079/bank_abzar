    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.2",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.59.0",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
