# نمونه‌ی متغیرهای محیطی بانک ابزار. کپی کن به `.env.local` (لوکال) و مقادیر را پر کن. هرگز مقدار واقعی را کامیت نکن.
# همین نام‌ها را در Vercel: Project → Settings → Environment Variables (برای Production و Preview) بساز.

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# دیتابیس PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/bank_abzar

# حداقل ۳۲ کاراکتر تصادفی (برای HMAC کد OTP و سشن): openssl rand -base64 48
SESSION_SECRET=742F6F73354E485265525A49637758334D4B4B4C2B5756796F574B6376546F6B78544B734E4E30624830303D

# پیامک: لوکال console (کد در ترمینال چاپ می‌شود)؛ production حتماً kavenegar
SMS_PROVIDER=console
# فقط وقتی SMS_PROVIDER=kavenegar
SMS_API_KEY=
# lookup (قالب تأییدشده؛ نیازمند «سرویس پیشرفته» کاوه‌نگار) یا send (پیامک ساده؛ حساب رایگان)
SMS_KAVENEGAR_METHOD=lookup
# فقط برای lookup
SMS_OTP_TEMPLATE=
# فقط برای send؛ خالی = خط پیش‌فرض حساب
SMS_SENDER=

# زرین‌پال (مرچنت‌کد ۳۶ کاراکتری)
ZARINPAL_MERCHANT_ID=

# توکن کرون (حداقل ۱۶ کاراکتر)
CRON_SECRET=

# تصاویر: local (دیسک سرور) یا blob (Vercel Blob)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# فقط وقتی STORAGE_DRIVER=blob
BLOB_READ_WRITE_TOKEN=
