# Copy to .env.local for local development. Never commit real credentials.
NODE_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql://bank_abzar:replace-with-a-long-random-local-password@localhost:5432/bank_abzar
SESSION_COOKIE_NAME=bank_abzar_session
SESSION_TTL_HOURS=168
APP_BASE_URL=http://localhost:3000
# Configure these only when a real provider account is available.
SMS_PROVIDER=disabled
SMS_API_KEY=
PAYMENT_PROVIDER=disabled
ZARINPAL_MERCHANT_ID=
# Mock payment must remain disabled in production.
ALLOW_MOCK_PAYMENTS=false
