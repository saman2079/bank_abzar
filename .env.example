# کپی کن به .env.local و مقدارها را پر کن. این فایل هرگز مقدار واقعی نداشته باشد.

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# فاز ۲ — دیتابیس (مقدار پیش‌فرض با docker/compose.dev.yml هماهنگ است)
DATABASE_URL=postgresql://bank_abzar:bank_abzar_dev@localhost:5432/bank_abzar

# فاز ۳ — احراز هویت (الزامی؛ حداقل ۳۲ کاراکتر تصادفی: openssl rand -base64 48)
SESSION_SECRET=
# console = کد OTP در ترمینال چاپ می‌شود (فقط توسعه). در production باید kavenegar باشد.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_OTP_TEMPLATE=

# فاز ۴ — کرون انقضای سفارش (حداقل ۱۶ کاراکتر)
CRON_SECRET=

# فاز ۵ — زرین‌پال (واقعی، نه sandbox): مرچنت‌کد ۳۶ کاراکتری پنل زرین‌پال
# دامنه‌ی callback باید همان دامنه‌ی ثبت‌شده در زرین‌پال باشد؛ روی localhost کار نمی‌کند.
ZARINPAL_MERCHANT_ID=

# فاز ۶B — ذخیره‌ی تصاویر محصول
# local = روی دیسک (مسیر UPLOAD_DIR؛ روی سرور یک volume)، blob = Vercel Blob (برای Vercel لازم است چون دیسک آن فقط‌خواندنی است)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
BLOB_READ_WRITE_TOKEN=
